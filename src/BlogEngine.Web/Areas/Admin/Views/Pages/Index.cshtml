@model List<Page>
@{
    ViewData["Title"] = L["Pages"].Value;
    var trash = ViewBag.Trash == true;
}
<h1>@L["Pages"]</h1>
<div class="toolbar">
    <div class="tabs">
        <a class="@(trash ? "" : "active")" href="/admin/pages">@L["Pages"]</a>
        <a class="@(trash ? "active" : "")" href="/admin/pages?trash=true">@L["Trash"]</a>
    </div>
    <a class="btn" href="/admin/pages/create">@L["New page"]</a>
</div>
<div class="table-wrap">
<table class="grid">
    <thead><tr><th>@L["Title"]</th><th>@L["Parent"]</th><th>@L["Status"]</th><th></th></tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td><a href="/admin/pages/edit/@p.Id"><strong>@p.Title</strong></a>@if (p.IsFrontPage) { <span class="status"> @L["front page"]</span> }</td>
            <td>@p.Parent?.Title</td>
            <td>@if (p.IsPublished) { <span class="status status-published">@L["Published"].Value.ToLower()</span> } else { <span class="status status-draft">@L["draft"]</span> }</td>
            <td>
                <div class="row-actions">
                    @if (trash)
                    {
                        <form asp-action="Restore" asp-route-id="@p.Id" method="post"><button class="btn btn-small btn-secondary">@L["Restore"]</button></form>
                        <form asp-action="Delete" asp-route-id="@p.Id" method="post" data-confirm="@L["Delete this page permanently?"]"><button class="btn btn-small btn-danger">@L["Delete forever"]</button></form>
                    }
                    else
                    {
                        <a class="btn btn-small btn-secondary" asp-area="" asp-controller="Pages" asp-action="Details" asp-route-slug="@p.Slug" target="_blank">@L["View"]</a>
                        <form asp-action="Trash" asp-route-id="@p.Id" method="post"><button class="btn btn-small btn-secondary">@L["Trash"]</button></form>
                    }
                </div>
            </td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="4" class="muted">@L["No pages."]</td></tr> }
    </tbody>
</table>
</div>
