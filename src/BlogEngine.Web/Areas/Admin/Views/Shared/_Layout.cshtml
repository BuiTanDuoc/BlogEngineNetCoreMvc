@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.EntityFrameworkCore
@inject BlogEngine.Web.Data.BlogDbContext Db
@inject IAntiforgery Antiforgery
@inject ISettingsService SettingsService
@{
    var settings = await SettingsService.GetAsync();
    var pending = await Db.Comments.CountAsync(c => !c.IsApproved && !c.IsSpam && !c.IsDeleted);
    var unread = await Db.ContactMessages.CountAsync(m => !m.IsRead);
    var controller = (ViewContext.RouteData.Values["controller"] as string) ?? "";
    string Active(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Uri.EscapeDataString(Context.Request.Path.Add(Context.Request.QueryString));
}
<!DOCTYPE html>
<html lang="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="csrf-token" content="@token" />
    <script>
        (function () {
            try {
                var t = localStorage.getItem('theme');
                if (!t) { t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }
                document.documentElement.setAttribute('data-theme', t);
            } catch (e) { document.documentElement.setAttribute('data-theme', 'light'); }
        })();
    </script>
    <title>@(ViewData["Title"] ?? L["Admin"].Value) · @settings.Name</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin">
<aside class="admin-sidebar">
    <a class="admin-brand" href="/admin">@settings.Name<small>@L["Administration"]</small></a>
    <div class="admin-tools">
        <div class="lang-switch" role="group" aria-label="@L["Language"]">
            @foreach (var code in SupportedLanguages.Codes)
            {
                <a href="/lang/@code?returnUrl=@returnUrl" class="@(lang == code ? "active" : "")" lang="@code" hreflang="@code"
                   title="@SupportedLanguages.DisplayName(code)">@code.ToUpperInvariant()</a>
            }
        </div>
        <button type="button" id="theme-toggle" class="icon-btn" aria-label="@L["Toggle light/dark theme"]" title="@L["Toggle light/dark theme"]">
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
    </div>
    <nav>
        <a class="@Active("Dashboard")" href="/admin">@L["Dashboard"]</a>
        <a class="@Active("Posts")" href="/admin/posts">@L["Posts"]</a>
        <a class="@Active("Pages")" href="/admin/pages">@L["Pages"]</a>
        <a class="@Active("Categories")" href="/admin/categories">@L["Categories"]</a>
        <a class="@Active("Tags")" href="/admin/tags">@L["Tags"]</a>
        <a class="@Active("Comments")" href="/admin/comments">@L["Comments"] @if (pending > 0) { <span class="badge">@pending</span> }</a>
        <a class="@Active("Messages")" href="/admin/messages">@L["Messages"] @if (unread > 0) { <span class="badge">@unread</span> }</a>
        <a class="@Active("Media")" href="/admin/media">@L["Media"]</a>
        @if (User.IsAdministrator())
        {
            <hr />
            <a class="@Active("Users")" href="/admin/users">@L["Users"]</a>
            <a class="@Active("BlogRoll")" href="/admin/blogroll">@L["Blogroll"]</a>
            <a class="@Active("Settings")" href="/admin/settings">@L["Settings"]</a>
        }
        <hr />
        <a href="/" target="_blank" rel="noopener">@L["View site"] ↗</a>
        <a href="/account/change-password">@L["Change password"]</a>
        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="linklike">@L["Sign out"] (@User.Identity?.Name)</button>
        </form>
    </nav>
</aside>

<main class="admin-main">
    @if (TempData["Message"] is string ok) { <div class="alert alert-success" role="status">@ok</div> }
    @if (TempData["Error"] is string err) { <div class="alert alert-danger" role="alert">@err</div> }
    @RenderBody()
</main>

<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/admin.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
