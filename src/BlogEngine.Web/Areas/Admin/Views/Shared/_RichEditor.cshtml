@model string
@{
    var uiLang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}
@* Trình soạn thảo WYSIWYG (TinyMCE 6, MIT, tự host trong wwwroot/lib/tinymce). Cấu hình ở js/editor.js. *@
<div class="editor-tabs" role="group" aria-label="@L["Editor mode"]">
    <button type="button" class="active" data-editor-mode="visual" aria-pressed="true">@L["Visual"]</button>
    <button type="button" data-editor-mode="html" aria-pressed="false">HTML</button>
</div>
<textarea id="editor" name="Content" rows="18" spellcheck="true"
          data-lang="@uiLang"
          data-msg-youtube-label="@L["YouTube link"]"
          data-msg-youtube-invalid="@L["Not a valid YouTube link."]"
          data-msg-uploading="@L["Uploading video…"]"
          data-msg-upload-failed="@L["Video upload failed."]"
          data-msg-too-large="@L["The video is too large for the server limit."]"
          data-msg-embed-youtube="@L["Embed a YouTube video"]"
          data-msg-upload-video="@L["Upload a video file"]"
          data-msg-attach-file="@L["Insert a download link (zip, Word, Excel, PDF…)"]"
          data-msg-pick-title="@L["Insert file"]"
          data-msg-tab-upload="@L["Upload"]"
          data-msg-tab-library="@L["Library"]"
          data-msg-pick-drop="@L["Drop a file here or click to choose"]"
          data-msg-pick-choose="@L["— choose a file —"]"
          data-msg-pick-none="@L["Upload a file or choose one from the library."]"
          data-msg-uploading-file="@L["Uploading file…"]"
          data-msg-hr="@L["Horizontal line"]">@Model</textarea>
<input type="file" id="video-file" accept="video/mp4,video/webm" hidden />
<script src="~/lib/tinymce/tinymce.min.js" asp-append-version="true"></script>
<script src="~/js/editor.js" asp-append-version="true"></script>
