@model List<Category>
@{
    ViewData["Title"] = L["Categories"].Value;
    var counts = (Dictionary<int, int>)ViewBag.Counts;
}
<h1>@L["Categories"]</h1>
<div class="toolbar"><span></span><a class="btn" href="/admin/categories/create">@L["New category"]</a></div>
<div class="table-wrap">
<table class="grid">
    <thead><tr><th>@L["Name"]</th><th>@L["Slug"]</th><th>@L["Parent"]</th><th>@L["Posts"]</th><th></th></tr></thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td><a href="/admin/categories/edit/@c.Id"><strong>@c.Name</strong></a><div class="muted small">@c.Description</div></td>
            <td>@c.Slug</td>
            <td>@c.Parent?.Name</td>
            <td>@(counts.TryGetValue(c.Id, out var n) ? n : 0)</td>
            <td>
                <form asp-action="Delete" asp-route-id="@c.Id" method="post" data-confirm="@L["Delete this category? Posts are kept."]">
                    <button class="btn btn-small btn-danger">@L["Delete"]</button>
                </form>
            </td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="5" class="muted">@L["No categories."]</td></tr> }
    </tbody>
</table>
</div>
