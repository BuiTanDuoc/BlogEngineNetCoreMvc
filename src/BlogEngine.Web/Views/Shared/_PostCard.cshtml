@model PostSummary
@inject ISettingsService SettingsService
@{
    var settings = await SettingsService.GetAsync();
    var summary = string.IsNullOrWhiteSpace(Model.Description) ? Model.Content.Excerpt(170) : Model.Description.Excerpt(200);
    var first = Model.Categories.FirstOrDefault();
    // Bài không công khai: hiện nhãn để người viết/người đã đăng nhập biết bài này không phải ai cũng thấy.
    var visLabel = Model.Visibility switch
    {
        ContentVisibility.Private => "🔒 " + L["Private"].Value,
        ContentVisibility.Personal => "👤 " + L["Personal"].Value,
        _ => null
    };
}
@if (settings.IsBlk)
{
    var bkImg = Model.ImageUrl;
    <article class="bk-card@(bkImg is null ? " no-thumb" : "")@(Model.IsFeatured ? " featured" : "")">
        @if (bkImg is not null)
        {
            <a class="bk-card-thumb" tabindex="-1" aria-hidden="true" asp-controller="Posts" asp-action="Details" asp-route-slug="@Model.Slug"><img src="@bkImg" alt="" loading="lazy" /></a>
        }
        <div class="bk-card-body">
            @if (Model.IsFeatured || first is not null || visLabel is not null)
            {
                <div class="bk-card-labels">
                    @if (visLabel is not null) { <span class="bk-chip vis-chip">@visLabel</span> }
                    @if (Model.IsFeatured) { <span class="bk-chip bk-chip-warm">★ @L["Featured"]</span> }
                    @if (first is not null) { <a class="bk-chip" asp-controller="Categories" asp-action="Details" asp-route-slug="@first.Slug">@first.Name</a> }
                </div>
            }
            <h3><a asp-controller="Posts" asp-action="Details" asp-route-slug="@Model.Slug">@Model.Title</a></h3>
            <p>@summary</p>
            <div class="bk-card-meta">
                <span>@Model.AuthorName</span>
                <span class="bk-dot">&middot;</span>
                <time datetime="@Model.DateCreated.ToString("o")">@Model.DateCreated.ToBlogTime(settings).ToString(L["MMM d, yyyy"].Value)</time>
                <span class="bk-dot">&middot;</span>
                <span>@L["{0} min read", Model.ReadingMinutes]</span>
                @if (Model.CommentCount > 0)
                {
                    <span class="bk-dot">&middot;</span>
                    <span>@L.Plural(Model.CommentCount, "{0} comment", "{0} comments")</span>
                }
            </div>
        </div>
    </article>
}
else if (settings.IsIndigo)
{
    var img = Model.ImageUrl;
    var when = Model.DateCreated.ToBlogTime(settings);
    <article class="ix-post@(img is null ? " no-thumb" : "")">
        @if (img is not null)
        {
            <a class="ix-thumb" tabindex="-1" aria-hidden="true" asp-controller="Posts" asp-action="Details" asp-route-slug="@Model.Slug"><img src="@img" alt="" loading="lazy" /></a>
        }
        <div class="ix-post-body">
            <h2><a asp-controller="Posts" asp-action="Details" asp-route-slug="@Model.Slug">@Model.Title</a></h2>
            <div class="ix-meta">
                <span>@L["by"] @Model.AuthorName</span>
                <span class="ix-sl">/</span>
                <time datetime="@Model.DateCreated.ToString("o")">@when.ToString(L["MMM d, yyyy"].Value)</time>
                @if (visLabel is not null)
                {
                    <span class="ix-sl">/</span>
                    <span class="vis-badge">@visLabel</span>
                }
                @if (Model.Categories.Count > 0)
                {
                    <span class="ix-sl">/</span>
                    <span>
                        @for (var i = 0; i < Model.Categories.Count; i++)
                        {
                            <a asp-controller="Categories" asp-action="Details" asp-route-slug="@Model.Categories[i].Slug">@Model.Categories[i].Name</a>@(i < Model.Categories.Count - 1 ? ", " : "")
                        }
                    </span>
                }
            </div>
            <p>@summary</p>
            <a class="ix-more" asp-controller="Posts" asp-action="Details" asp-route-slug="@Model.Slug">@L["Read more"]</a>
        </div>
    </article>
}
else
{
<article class="card hoverable@(Model.IsFeatured ? " featured" : "")@(Model.ImageUrl is null ? "" : " has-thumb")">
    @if (Model.ImageUrl is { } thumb)
    {
        <a class="card-thumb" tabindex="-1" aria-hidden="true" asp-controller="Posts" asp-action="Details" asp-route-slug="@Model.Slug"><img src="@thumb" alt="" loading="lazy" /></a>
    }
    @if (Model.IsFeatured || first is not null || visLabel is not null)
    {
        <div class="card-labels">
            @if (visLabel is not null) { <span class="label label-vis">@visLabel</span> }
            @if (Model.IsFeatured) { <span class="label label-featured">★ @L["Featured"]</span> }
            @if (first is not null) { <span class="label">@first.Name</span> }
        </div>
    }
    <h3><a asp-controller="Posts" asp-action="Details" asp-route-slug="@Model.Slug">@Model.Title</a></h3>
    <p>@summary</p>
    <div class="card-meta">
        <time datetime="@Model.DateCreated.ToString("o")">@Model.DateCreated.ToBlogTime(settings).ToString(L["MMM d, yyyy"].Value)</time>
        <span class="sep">·</span>
        <span>@L["{0} min read", Model.ReadingMinutes]</span>
        @if (Model.CommentCount > 0)
        {
            <span class="sep">·</span>
            <span>@L.Plural(Model.CommentCount, "{0} comment", "{0} comments")</span>
        }
    </div>
</article>
}
