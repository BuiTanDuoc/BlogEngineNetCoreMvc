@inject ISettingsService SettingsService
@{
    var settings = await SettingsService.GetAsync();
    var pageTitle = ViewData["Title"] as string;
    var description = ViewData["Description"] as string;
    if (string.IsNullOrWhiteSpace(description)) { description = settings.Description; }
    var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isStaff = User.IsStaff();
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var returnUrl = Uri.EscapeDataString(Context.Request.Path.Add(Context.Request.QueryString));
}
<!DOCTYPE html>
<html lang="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script>
        // Áp dụng theme trước khi render để không bị nháy sáng/tối.
        (function () {
            try {
                var t = localStorage.getItem('theme');
                if (!t) { t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }
                document.documentElement.setAttribute('data-theme', t);
            } catch (e) { document.documentElement.setAttribute('data-theme', 'light'); }
        })();
    </script>
    <title>@(string.IsNullOrWhiteSpace(pageTitle) ? settings.Name : $"{pageTitle} | {settings.Name}")</title>
    <meta name="description" content="@description" />
    <meta property="og:site_name" content="@settings.Name" />
    <meta property="og:title" content="@(string.IsNullOrWhiteSpace(pageTitle) ? settings.Name : pageTitle)" />
    <meta property="og:description" content="@description" />
    <link rel="alternate" type="application/rss+xml" title="@settings.Name (RSS)" href="/feed" />
    <link rel="alternate" type="application/atom+xml" title="@settings.Name (Atom)" href="/feed/atom" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
<a class="visually-hidden" href="#main">@L["Skip to content"]</a>
<header class="site-header">
    <div class="container header-inner">
        <a class="brand" href="/" aria-label="@settings.Name">
            <span class="brand-mark" aria-hidden="true">&lt;/&gt;</span>
            <span>@settings.Name</span>
        </a>
        <nav class="main-nav" aria-label="@L["Main"]">
            <a href="/">@L["Home"]</a>
            <a href="/blog">@L["Blog"]</a>
            <a asp-controller="Archive" asp-action="Index">@L["Archive"]</a>
            <a asp-controller="Contact" asp-action="Index">@L["Contact"]</a>
            @await Component.InvokeAsync("Nav")
        </nav>
        <div class="header-tools">
            <form action="/search" method="get" class="search-form" role="search">
                <input type="search" name="q" value="@(ViewData["SearchTerm"] as string)" placeholder="@L["Search…"]" aria-label="@L["Search"]" />
            </form>
            <div class="lang-switch" role="group" aria-label="@L["Language"]">
                @foreach (var code in SupportedLanguages.Codes)
                {
                    <a href="/lang/@code?returnUrl=@returnUrl" class="@(lang == code ? "active" : "")" lang="@code" hreflang="@code"
                       title="@SupportedLanguages.DisplayName(code)" aria-current="@(lang == code ? "true" : null)">@code.ToUpperInvariant()</a>
                }
            </div>
            <button type="button" id="theme-toggle" class="icon-btn" aria-label="@L["Toggle light/dark theme"]" title="@L["Toggle light/dark theme"]">
                <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            </button>
            @if (isSignedIn)
            {
                @if (isStaff) { <a class="btn btn-small btn-ghost" href="/admin">@L["Admin"]</a> }
                <form asp-controller="Account" asp-action="Logout" method="post" class="inline-form">
                    <button type="submit" class="btn btn-small btn-link">@L["Sign out"]</button>
                </form>
            }
            else
            {
                <a class="btn btn-small btn-link" asp-controller="Account" asp-action="Login">@L["Sign in"]</a>
            }
        </div>
    </div>
</header>

<main class="container page" id="main">
    @if (TempData["Message"] is string flash)
    {
        <div class="alert alert-success" role="status">@flash</div>
    }
    @RenderBody()
</main>

<footer class="site-footer">
    <div class="container">
        @await Component.InvokeAsync("Footer")
        <div class="footer-bottom">
            <span>&copy; @DateTime.UtcNow.Year @settings.Name</span>
            <span>@L["Powered by ASP.NET Core"]</span>
        </div>
    </div>
</footer>

<script src="~/js/site.js" asp-append-version="true"></script>
@if (!string.IsNullOrWhiteSpace(settings.TrackingScript))
{
    @Html.Raw(settings.TrackingScript)
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
