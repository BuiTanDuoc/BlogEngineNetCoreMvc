@inject ISettingsService SettingsService
@{
    var settings = await SettingsService.GetAsync();
    var pageTitle = ViewData["Title"] as string;
    var description = ViewData["Description"] as string;
    if (string.IsNullOrWhiteSpace(description)) { description = settings.Description; }
    var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isStaff = User.IsStaff();
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var returnUrl = Uri.EscapeDataString(Context.Request.Path.Add(Context.Request.QueryString));
    var facebook = settings.SocialFacebook.ToSafeHttpUrl();
    var twitter = settings.SocialTwitter.ToSafeHttpUrl();
    var linkedIn = settings.SocialLinkedIn.ToSafeHttpUrl();
}
<!DOCTYPE html>
<html lang="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script>
        // Áp dụng sáng/tối trước khi render để không bị nháy.
        (function () {
            try {
                var t = localStorage.getItem('theme');
                // BLK mặc định tối (đúng chất BLK Design System); người dùng đổi thì lưu lại.
                if (!t) { t = 'dark'; document.documentElement.setAttribute('data-theme-default', 'dark'); }
                document.documentElement.setAttribute('data-theme', t);
            } catch (e) { document.documentElement.setAttribute('data-theme', 'light'); }
        })();
    </script>
    <title>@(string.IsNullOrWhiteSpace(pageTitle) ? settings.Name : $"{pageTitle} | {settings.Name}")</title>
    <meta name="description" content="@description" />
    <meta property="og:site_name" content="@settings.Name" />
    <meta property="og:title" content="@(string.IsNullOrWhiteSpace(pageTitle) ? settings.Name : pageTitle)" />
    <meta property="og:description" content="@description" />
    <link rel="alternate" type="application/rss+xml" title="@settings.Name (RSS)" href="/feed" />
    <link rel="alternate" type="application/atom+xml" title="@settings.Name (Atom)" href="/feed/atom" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/blk.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="bk">
<a class="visually-hidden" href="#main">@L["Skip to content"]</a>

<header class="bk-header">
    <div class="bk-wrap bk-header-inner">
        <a class="bk-brand" href="/" aria-label="@settings.Name">@settings.Name</a>
        <button type="button" class="bk-burger" id="bk-burger" aria-label="@L["Menu"]" aria-expanded="false" aria-controls="bk-menu"><span></span></button>
        <div class="bk-menu" id="bk-menu">
            <nav class="bk-nav" aria-label="@L["Main"]">
                <a href="/">@L["Home"]</a>
                <a href="/blog">@L["Blog"]</a>
                <a asp-controller="Archive" asp-action="Index">@L["Archive"]</a>
                <a asp-controller="Contact" asp-action="Index">@L["Contact"]</a>
                @await Component.InvokeAsync("Nav")
            </nav>
            <div class="bk-tools">
                <form action="/search" method="get" class="search-form" role="search">
                    <input type="search" name="q" value="@(ViewData["SearchTerm"] as string)" placeholder="@L["Search…"]" aria-label="@L["Search"]" />
                </form>
                <div class="lang-switch" role="group" aria-label="@L["Language"]">
                    @foreach (var code in SupportedLanguages.Codes)
                    {
                        <a href="/lang/@code?returnUrl=@returnUrl" class="@(lang == code ? "active" : "")" lang="@code" hreflang="@code"
                           title="@SupportedLanguages.DisplayName(code)" aria-current="@(lang == code ? "true" : null)">@code.ToUpperInvariant()</a>
                    }
                </div>
                <button type="button" id="theme-toggle" class="icon-btn" aria-label="@L["Toggle light/dark theme"]" title="@L["Toggle light/dark theme"]">
                    <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                    <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
                </button>
                @if (isSignedIn)
                {
                    @if (isStaff) { <a class="bk-link" href="/admin">@L["Admin"]</a> }
                    <form asp-controller="Account" asp-action="Logout" method="post" class="inline-form">
                        <button type="submit" class="bk-link bk-link-btn">@L["Sign out"]</button>
                    </form>
                }
                else
                {
                    <a class="bk-link" asp-controller="Account" asp-action="Login">@L["Sign in"]</a>
                }
            </div>
        </div>
    </div>
</header>

@await RenderSectionAsync("Hero", required: false)

<div class="bk-wrap bk-page">
    <main class="bk-main" id="main">
        @if (TempData["Message"] is string flash)
        {
            <div class="alert alert-success" role="status">@flash</div>
        }
        @RenderBody()
    </main>
    <aside class="bk-aside" aria-label="@L["Sidebar"]">
        @await Component.InvokeAsync("Sidebar")
    </aside>
</div>

<footer class="bk-footer">
    <div class="bk-wrap">
        <div class="bk-footer-top">
            <div class="bk-footer-brand">
                <div class="bk-flogo">@settings.Name</div>
                <p class="bk-fdesc">@settings.Description</p>
            </div>
            <nav class="bk-flinks" aria-label="@L["Footer"]">
                <a href="/">@L["Home"]</a>
                <a href="/blog">@L["Blog"]</a>
                <a asp-controller="Archive" asp-action="Index">@L["Archive"]</a>
                <a asp-controller="Contact" asp-action="Index">@L["Contact"]</a>
            </nav>
            <div class="bk-social">
                @if (facebook is not null)
                {
                    <a href="@facebook" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 8h2V5h-2.5C10.9 5 10 6.6 10 8.5V10H8v3h2v6h3v-6h2.2l.4-3H13V8.7c0-.5.2-.7 1-.7z"/></svg></a>
                }
                @if (twitter is not null)
                {
                    <a href="@twitter" target="_blank" rel="noopener" aria-label="X"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.2 3h2.9l-6.3 7.2L22 21h-5.8l-4.5-5.9L6.5 21H3.6l6.7-7.7L3 3h5.9l4.1 5.4L18.2 3z"/></svg></a>
                }
                @if (linkedIn is not null)
                {
                    <a href="@linkedIn" target="_blank" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 9h3.5v11H4zM5.75 3.5a2 2 0 110 4 2 2 0 010-4zM10 9h3.3v1.5c.5-.9 1.7-1.8 3.4-1.8 3.5 0 4.3 2.3 4.3 5.3V20h-3.5v-5.2c0-1.3 0-2.8-1.8-2.8s-2 1.3-2 2.7V20H10z"/></svg></a>
                }
                <a href="/feed" aria-label="RSS"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 11a8 8 0 0 1 8 8M5 5a14 14 0 0 1 14 14"/><circle cx="6" cy="18" r="1.2" fill="currentColor"/></svg></a>
                <a href="#" id="bk-top" aria-label="@L["Back to top"]"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 14l6-6 6 6"/></svg></a>
            </div>
        </div>
        <div class="bk-footer-bottom">&copy; @DateTime.UtcNow.Year @settings.Name &middot; @L["Powered by ASP.NET Core"]</div>
    </div>
</footer>

<script src="~/js/site.js" asp-append-version="true"></script>
@if (!string.IsNullOrWhiteSpace(settings.TrackingScript))
{
    @Html.Raw(settings.TrackingScript)
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
