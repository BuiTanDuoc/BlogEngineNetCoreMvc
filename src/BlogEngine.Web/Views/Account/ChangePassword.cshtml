@model ChangePasswordInput
@{ ViewData["Title"] = L["Change password"].Value; }
<header class="page-heading"><h1>@L["Change password"]</h1></header>

@if (ViewBag.Forced == true)
{
    <div class="alert alert-warning">@L["You must choose a new password before continuing."]</div>
}

<form asp-action="ChangePassword" asp-route-returnUrl="@(ViewBag.ReturnUrl as string)" method="post" class="form form-narrow">
    <div asp-validation-summary="All" class="validation-summary"></div>
    <div class="field">
        <label asp-for="CurrentPassword"></label>
        <input asp-for="CurrentPassword" autocomplete="current-password" required />
    </div>
    <div class="field">
        <label asp-for="NewPassword"></label>
        <input asp-for="NewPassword" autocomplete="new-password" minlength="8" required />
        <span class="muted small">@L["At least 8 characters."]</span>
    </div>
    <div class="field">
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" autocomplete="new-password" required />
    </div>
    <button type="submit" class="btn">@L["Change password"]</button>
</form>
