@model ForgotPasswordInput
@{ ViewData["Title"] = L["Forgot your password?"].Value; }
<header class="page-heading"><h1>@L["Forgot your password?"]</h1></header>

<p class="muted">@L["Enter your username or email. If it belongs to an administrator or editor account with an email address, we will send a link to reset the password."]</p>

<form asp-action="ForgotPassword" method="post" class="form form-narrow">
    <div asp-validation-summary="All" class="validation-summary"></div>
    <div class="field">
        <label asp-for="Identifier"></label>
        <input asp-for="Identifier" autocomplete="username" autofocus required />
    </div>
    <button type="submit" class="btn">@L["Send reset link"]</button>
    <p class="muted small"><a asp-action="Login">@L["Back to sign in"]</a></p>
</form>
