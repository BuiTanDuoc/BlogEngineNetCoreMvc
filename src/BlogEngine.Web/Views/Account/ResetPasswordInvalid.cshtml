@{ ViewData["Title"] = L["Reset link is invalid"].Value; }
<header class="page-heading"><h1>@L["Reset link is invalid"]</h1></header>
<div class="alert alert-warning">@L["This password reset link is invalid, expired or already used."]</div>
<p><a class="btn" asp-action="ForgotPassword">@L["Request a new link"]</a></p>
