@model ResetPasswordInput
@{ ViewData["Title"] = L["Reset your password"].Value; }
<header class="page-heading"><h1>@L["Reset your password"]</h1></header>

<form asp-action="ResetPassword" method="post" class="form form-narrow">
    <div asp-validation-summary="All" class="validation-summary"></div>
    <input type="hidden" asp-for="Token" />
    <div class="field">
        <label asp-for="NewPassword"></label>
        <input asp-for="NewPassword" autocomplete="new-password" minlength="8" autofocus required />
        <span class="muted small">@L["At least 8 characters."]</span>
    </div>
    <div class="field">
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" autocomplete="new-password" required />
    </div>
    <button type="submit" class="btn">@L["Reset password"]</button>
</form>
